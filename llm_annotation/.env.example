# Copy to .env without replacing an existing file. Set only providers you use.
# Never commit real keys. Existing values for the same variable name are kept.
OPENAI_API_KEY=
# Google uses a Gemini Developer API key (AI Studio), not Vertex AI.
# GOOGLE_API_KEY also works in place of GEMINI_API_KEY.
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# Optional override. The default is the version used for the released sample.
TYPESAFE_MODEL_ID=jev-1.14.0
